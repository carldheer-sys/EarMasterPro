{
  "name": "ear-master-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "node scripts/generate-session-catalog.mjs",
    "dev": "npm run catalog && vite --config apps/desktop/vite.config.js",
    "dev:desktop": "npm run catalog && vite --config apps/desktop/vite.config.js",
    "build": "npm run build:desktop",
    "build:backend": "node scripts/build-backend-app.mjs",
    "build:desktop": "npm run catalog && vite build --config apps/desktop/vite.config.js",
    "preview:desktop": "vite preview --outDir dist/desktop --host 0.0.0.0",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:backend && tauri build"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@tonejs/midi": "^2.0.28",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwind-merge": "^2.0.0",
    "tone": "^14.7.77"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0"
  }
}
